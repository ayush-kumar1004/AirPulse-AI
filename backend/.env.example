# Backend env template. Copy to backend/.env and fill secrets. NEVER commit backend/.env.

# --- App ---
CITY=Delhi
ENV=development
LOG_LEVEL=info

# --- Database (Postgres + PostGIS) ---
# Local-host default; docker-compose overrides the host to "db" automatically.
DATABASE_URL=postgresql://airpulse:airpulse@localhost:5432/airpulse

# --- Redis ---
# Local-host default; docker-compose overrides the host to "redis" automatically.
REDIS_URL=redis://localhost:6379/0

# --- AI features (officer chat, citizen advisory, recommendations) ---
# ONE key is enough. Gemini is primary; if it is empty the app falls back to
# Claude -> GPT -> Kimi, whichever key is set. With no key at all, only the AI
# features fail — map/AQI/weather/forecast still work (Open-Meteo needs no key).
#
# Free Gemini key: https://aistudio.google.com -> "Get API key" -> paste below.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional fallbacks (leave empty unless you have them):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
