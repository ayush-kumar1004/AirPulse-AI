# Backend env template. Copy to backend/.env and fill secrets. Owner: Person A.
# --- App ---
CITY=Delhi                      # the ONE city for this build (Delhi | Bhopal)
ENV=development
LOG_LEVEL=info

# --- Database (Postgres + PostGIS) ---
# Local host default; docker-compose overrides host to "db".
DATABASE_URL=postgresql://airpulse:airpulse@localhost:5432/airpulse

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- External data sources (Person A) ---
OPENAQ_API_KEY=                 # https://openaq.org  (free key)
# Open-Meteo needs no key. CPCB is scraped/optional.

# --- LLM providers (Person C) ---
ANTHROPIC_API_KEY=              # Claude — primary agent model
OPENAI_API_KEY=                 # GPT — fallback / embeddings
KIMI_API_KEY=                   # Moonshot Kimi — optional

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
