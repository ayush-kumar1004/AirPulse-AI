# Backend env template. Copy to backend/.env and fill secrets. NEVER commit backend/.env.

# --- App ---
CITY=Delhi
ENV=development
LOG_LEVEL=info

# --- Database (Postgres + PostGIS) ---
# Local-host default; docker-compose overrides the host to "db" automatically.
DATABASE_URL=postgresql://airpulse:airpulse@localhost:5432/airpulse

# --- Redis ---
# Local-host default; docker-compose overrides the host to "redis" automatically.
REDIS_URL=redis://localhost:6379/0

# --- AI features (officer chat, citizen advisory, recommendations) ---
# ONE key is enough. Mistral or Gemini are primary; if empty or quota-exhausted,
# the app seamlessly fails over across all configured keys (Mistral -> Gemini -> GPT -> Claude -> Kimi).
# With no key at all, heuristic AI fallback activates so the app never crashes.
#
# Preferred LLM provider: "mistral" | "gemini" | "auto" (default: auto)
LLM_PROVIDER=auto

# --- Mistral AI (High free limits & fast response times) ---
# Get your free key at: https://console.mistral.ai -> "API Keys" -> "Create new key"
MISTRAL_API_KEY=
# Optional pool of extra Mistral keys (comma-separated):
MISTRAL_API_KEYS=
# Default recommended model: "open-mistral-7b" (or "ministral-8b-latest", "codestral-latest")
MISTRAL_MODEL=open-mistral-7b

# --- Google Gemini AI ---
# Free Gemini key: https://aistudio.google.com -> "Get API key" -> paste below.
GEMINI_API_KEY=
# Extra Gemini keys, comma-separated, no spaces:
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-flash-latest

# Optional fallbacks (leave empty unless you have them):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
