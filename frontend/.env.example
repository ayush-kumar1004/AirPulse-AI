# Frontend env template. Copy to frontend/.env. Owner: Person D.
# The ONE backend URL the whole app talks to (see src/api/client.ts).
VITE_API_BASE_URL=http://localhost:8000

# Map tiles (MapLibre works with free demo tiles; add a Mapbox token here if you switch to Mapbox GL).
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
